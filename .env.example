# Copy to .env.local (local) or set in the hosting provider (staging/production).
# ONLY public values belong here: the Supabase project URL and the PUBLISHABLE key.
# Never put a secret/service-role key in a VITE_* variable (it would be shipped to every browser).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_ENV=local
# Shown on the "Account disabled" and help screens (OD-10)
VITE_SUPPORT_CONTACT=DCU@danamon.co.id
