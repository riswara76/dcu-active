{
  "name": "dcu-active",
  "version": "0.2.0",
  "private": true,
  "description": "DCU Active - sports and recreational facility booking (Supabase backend + React PWA)",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "test:concurrency": "vitest run --config tests/integration/vitest.config.ts tests/integration/concurrency"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.117.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "supabase": "2.120.0",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
