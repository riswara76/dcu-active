{
  "name": "dcu-active",
  "version": "0.2.0",
  "private": true,
  "description": "DCU Active - sports and recreational facility booking (Supabase backend + React PWA)",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "scan:bundle": "node scripts/bundle-secret-scan.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "test:concurrency": "vitest run --config tests/integration/vitest.config.ts tests/integration/concurrency",
    "test:e2e": "playwright test",
    "deploy:staging": "tsc -p tsconfig.json && vite build --mode staging && npm run scan:bundle && wrangler deploy"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "pg": "8.23.1",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4",
    "workbox-build": "7.4.1",
    "wrangler": "4.150.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.2",
    "lucide-react": "1.56.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "workbox-window": "7.4.1"
  }
}
