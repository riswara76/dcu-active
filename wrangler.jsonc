{
  // DCU Active — static hosting on Cloudflare (Workers static assets). No server code is deployed.
  // dist/_headers (CSP, HSTS, cache rules) is generated by vite.config.ts and applied by Cloudflare.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dcu-active-staging",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,       // staging URL: https://dcu-active-staging.dcu-active.workers.dev
  "preview_urls": false,     // no extra public per-version URLs
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
